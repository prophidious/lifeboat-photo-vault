<?xml version="1.0" encoding="utf-8"?>
<!--
  THE WALL: this app deliberately requests NO internet permission.
  It cannot upload, sync or "phone home" - the operating system won't let it.
  allowBackup=false + data extraction rules keep Google/Android cloud backup out too.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional: reading an SD card through a USB card reader for deleted-photo recovery. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".LifeboatApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lifeboat">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Lifeboat.Viewer" />

        <service
            android:name=".WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
